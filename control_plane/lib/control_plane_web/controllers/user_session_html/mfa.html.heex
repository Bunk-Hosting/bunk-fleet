<div class="auth">
  <div class="auth-card">
    <div class="brand">bunk<span class="d">.</span>cloud</div>
    <h1>Twee-factor</h1>
    <p class="sub">Voer de 6-cijferige code uit je authenticator-app in.</p>

    <%= if @error do %><div class="auth-err">{@error}</div><% end %>
    <form action={~p"/login/mfa"} method="post">
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
      <label for="code">Code</label>
      <input id="code" type="text" name="totp[code]" inputmode="numeric" autocomplete="one-time-code"
             maxlength="6" pattern="[0-9]*" required autofocus />
      <button type="submit">Verifiëren</button>
    </form>
    <p class="auth-alt"><a href={~p"/login"}>Terug naar inloggen</a></p>
  </div>
</div>

<style>
  .auth { min-height: 100vh; display: grid; place-items: center; padding: 24px; }
  .auth-card { width: 100%; max-width: 400px; background: #11161d; border: 1px solid #232a33; border-radius: 14px; padding: 32px; }
  .auth-card h1 { font-size: 22px; margin: 0 0 4px; }
  .auth-card .sub { color: #8b949e; margin: 0 0 22px; font-size: 13px; }
  .auth-card label { display:block; font-size: 12px; color:#8b949e; margin: 14px 0 6px; }
  .auth-card input { width:100%; padding:10px 12px; background:#0b0f14; border:1px solid #2d3540; border-radius:8px; color:#e6edf3; font-size:18px; letter-spacing:4px; text-align:center; }
  .auth-card input:focus { outline:none; border-color:#3081f7; }
  .auth-card button { width:100%; margin-top:22px; padding:11px; background:#2563eb; border:none; border-radius:8px; color:#fff; font-weight:600; font-size:14px; cursor:pointer; }
  .auth-err { background:#2d1417; border:1px solid #5c2228; color:#ff9b9b; padding:9px 12px; border-radius:8px; font-size:13px; margin-bottom:14px; }
  .auth-alt { text-align:center; margin-top:18px; font-size:13px; color:#8b949e; }
  .brand { font-weight:800; font-size:20px; margin-bottom:18px; }
  .brand .d { color:#3081f7; }
</style>
