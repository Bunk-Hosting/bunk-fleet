<div class="min-h-screen flex flex-col bg-background bg-dot-grid">
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
    <div class="absolute top-[-15%] right-[-12%] w-[55%] h-[55%] rounded-full bg-primary/15 blur-[120px] animate-glow"></div>
    <div class="absolute bottom-[-20%] left-[-10%] w-[45%] h-[45%] rounded-full bg-accent/10 blur-[100px] animate-glow-slow"></div>
  </div>
  <header class="fixed top-0 w-full z-50 bg-background/80 backdrop-blur-xl border-b border-outline-variant/10">
    <div class="max-w-7xl mx-auto flex justify-between items-center px-6 lg:px-8 h-16 w-full">
      <a href="https://bunkhosting.nl" class="flex items-center gap-3">
        <span class="material-symbols-outlined text-accent" style="font-variation-settings:'FILL' 1">dns</span>
        <span class="text-lg font-headline font-black tracking-tighter text-foreground uppercase">BUNK HOSTING</span>
      </a>
    </div>
  </header>
  <main class="relative z-10 flex-1 flex items-center justify-center py-12 px-4 pt-28">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-display font-bold mb-2">Authenticator-code</h1>
        <p class="text-muted-foreground">Voer de 6-cijferige code in uit je authenticator-app</p>
      </div>
      <div class="card-gradient-border rounded-xl p-6 bg-card">
        <%= if @error do %>
          <div class="mb-4 rounded-md border border-destructive/40 bg-destructive/10 px-3 py-2 text-sm text-destructive">{@error}</div>
        <% end %>
        <form action={~p"/login/mfa"} method="post" class="space-y-5">
          <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
          <div class="space-y-2">
            <label for="code" class="text-sm font-medium leading-none">Authenticator-code</label>
            <input id="code" name="totp[code]" type="text" inputmode="numeric" maxlength="6" autofocus autocomplete="one-time-code" pattern="[0-9]*" required placeholder="123456"
              class="flex h-10 w-full rounded-md border border-input bg-background/60 px-3 py-2 text-center tracking-widest text-lg text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus:border-primary/60" />
            <p class="text-xs text-muted-foreground text-center">Open je authenticator-app en voer de huidige 6-cijferige code in.</p>
          </div>
          <button type="submit"
            class="inline-flex items-center justify-center w-full py-5 rounded-md text-sm font-semibold bg-gradient-to-r from-primary to-accent text-primary-foreground transition-all hover:brightness-110 active:scale-[0.97]">
            Verifiëren
          </button>
          <a href={~p"/login"} class="inline-flex items-center justify-center w-full py-2 rounded-md text-sm font-medium text-muted-foreground hover:bg-accent/10 hover:text-accent transition-colors">← Terug naar inloggen</a>
        </form>
      </div>
    </div>
  </main>
</div>
