<div class="auth">
  <div class="auth-card">
    <div class="brand">bunk<span class="d"> hosting</span></div>
    <h1>Account aanmaken</h1>
    <p class="sub">Begin met het hosten van VPS-servers.</p>

    <%= for err <- @errors do %><div class="auth-err">{err}</div><% end %>
    <form action={~p"/register"} method="post">
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
      <label for="name">Naam</label>
      <input id="name" type="text" name="user[name]" autocomplete="name" />
      <label for="email">E-mailadres</label>
      <input id="email" type="email" name="user[email]" required autocomplete="username" />
      <label for="password">Wachtwoord (min. 12 tekens)</label>
      <input id="password" type="password" name="user[password]" required autocomplete="new-password" />
      <button type="submit">Account aanmaken</button>
    </form>
    <p class="auth-alt">Al een account? <a href={~p"/login"}>Inloggen</a></p>
  </div>
</div>

    <style>
      .auth { min-height: 100vh; display: grid; place-items: center; padding: 24px; }
      .auth-card { width: 100%; max-width: 400px; background: #1a1c20; border: 1px solid #333539; border-radius: 14px; padding: 32px; }
      .auth-card h1 { font-size: 22px; margin: 0 0 4px; }
      .auth-card .sub { color: #8c90a1; margin: 0 0 22px; font-size: 13px; }
      .auth-card label { display:block; font-size: 12px; color:#8c90a1; margin: 14px 0 6px; }
      .auth-card input { width:100%; padding:10px 12px; background:#0c0e12; border:1px solid #333539; border-radius:8px; color:#e2e2e8; font-size:14px; }
      .auth-card input:focus { outline:none; border-color:#006af2; }
      .auth-card button { width:100%; margin-top:22px; padding:11px; background:#006af2; border:none; border-radius:8px; color:#fff; font-weight:600; font-size:14px; cursor:pointer; }
      .auth-card button:hover { background:#0055c4; }
      .auth-err { background:#2d1417; border:1px solid #5c2228; color:#ff9b9b; padding:9px 12px; border-radius:8px; font-size:13px; margin-bottom:14px; }
      .auth-alt { text-align:center; margin-top:18px; font-size:13px; color:#8c90a1; }
      .brand { font-weight:800; font-size:20px; margin-bottom:18px; }
      .brand .d { color:#006af2; }
    </style>
