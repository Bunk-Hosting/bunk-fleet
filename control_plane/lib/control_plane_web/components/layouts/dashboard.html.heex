<div class="min-h-screen bg-background bg-dot-grid">
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
    <div class="absolute top-[-15%] right-[-12%] w-[55%] h-[55%] rounded-full bg-primary/15 blur-[120px] animate-glow"></div>
    <div class="absolute bottom-[-20%] left-[-10%] w-[45%] h-[45%] rounded-full bg-accent/10 blur-[100px] animate-glow-slow"></div>
  </div>
  <ControlPlaneWeb.DashboardComponents.sidebar
    current_user={@current_user}
    current_path={assigns[:current_path] || "/dashboard"}
  />
  <div class="relative z-0 md:pl-64">
    <main class="p-4 md:p-8">
      <p :if={Phoenix.Flash.get(@flash, :info)} class="mb-4 rounded-md border border-accent/30 bg-accent/10 px-4 py-2 text-sm text-accent">
        {Phoenix.Flash.get(@flash, :info)}
      </p>
      <p :if={Phoenix.Flash.get(@flash, :error)} class="mb-4 rounded-md border border-destructive/40 bg-destructive/10 px-4 py-2 text-sm text-destructive">
        {Phoenix.Flash.get(@flash, :error)}
      </p>
      {@inner_content}
    </main>
  </div>
</div>
