<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@700;800&display=swap" rel="stylesheet" />
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
</head>
<body style="margin:0;padding:0;background-color:#0c0e12;font-family:'Inter',Arial,sans-serif;-webkit-font-smoothing:antialiased;">

  <!-- Outer wrapper -->
  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#0c0e12;min-height:100vh;">
    <tr>
      <td align="center" style="padding:40px 16px;">

        <!-- Container -->
        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;">

          <!-- Header / Logo -->
          <tr>
            <td align="center" style="padding-bottom:32px;">
              <table cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="padding-right:10px;vertical-align:middle;">
                    <!-- Server icon SVG -->
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="#00dbe7" xmlns="http://www.w3.org/2000/svg">
                      <path d="M4 3h16a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zm0 7h16a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1zm0 7h16a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-2a1 1 0 0 1 1-1zm13 1.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5zm-3 0a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5zm3-7a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5zm-3 0a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5zm3-7a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5zm-3 0a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5z"/>
                    </svg>
                  </td>
                  <td style="vertical-align:middle;">
                    <span style="font-family:'Manrope',Arial,sans-serif;font-size:20px;font-weight:800;letter-spacing:-0.5px;color:#e2e2e8;text-transform:uppercase;">BUNK HOSTING</span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Card -->
          <tr>
            <td style="background-color:#1a1c20;border-radius:16px;border:1px solid rgba(0,219,231,0.18);box-shadow:0 0 0 1px rgba(0,219,231,0.08),0 8px 48px rgba(0,106,242,0.12);overflow:hidden;">

              <!-- Accent top bar -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="height:3px;background:linear-gradient(90deg,#006af2,#00dbe7);border-radius:16px 16px 0 0;font-size:0;line-height:0;">&nbsp;</td>
                </tr>
              </table>

              <!-- Card content -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="padding:40px 40px 32px;">
                    <%= content %>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding-top:32px;">
              <p style="margin:0 0 8px;font-size:13px;color:#8c90a1;line-height:1.5;">
                Met vriendelijke groet, <strong style="color:#bec6e0;">Bunk Hosting</strong>
              </p>
              <p style="margin:0;font-size:12px;color:#555a6e;line-height:1.5;">
                &copy; <%= year %> Bunk Hosting &mdash;
                <a href="https://bunkhosting.nl" style="color:#00dbe7;text-decoration:none;">bunkhosting.nl</a>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
