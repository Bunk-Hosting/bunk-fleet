[Unit]
Description=Bunk Fleet worker agent
Documentation=https://github.com/Bunk-Hosting/bunk-fleet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Secrets + node config live here (chmod 600); see agent.env.example.
EnvironmentFile=/etc/bunk-agent/agent.env
ExecStart=/usr/local/bin/bunk-agent
Restart=always
RestartSec=5
# systemd creates/owns /var/lib/bunk-agent for persisted enrollment state, so the
# agent keeps the SAME node identity across restarts instead of re-enrolling.
StateDirectory=bunk-agent

# --- Sandboxing --------------------------------------------------------------
# The agent runs as root because it drives wg-quick (WireGuard overlay). The
# hardening below keeps that capability while removing everything it doesn't need.
# If overlay setup fails after an upgrade, relax the two lines flagged below first.
NoNewPrivileges=yes
ProtectSystem=strict
# wg-quick writes peer config under /etc/wireguard and resolvconf state under /run.
ReadWritePaths=/etc/wireguard /run
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
# Drop all capabilities except those wg-quick/ip actually use (relax here if the
# overlay fails to come up: some kernels need CAP_SYS_MODULE to load wireguard).
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_MODULE CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
