# /etc/bunk-agent/agent.env  (chmod 600 — contains secrets)
#
# One-time enrollment token (from: POST /api/v1/operator/enroll-tokens). Only used
# on first start; afterwards the agent reuses /var/lib/bunk-agent/state.json.
BUNK_ENROLL_TOKEN=

# Control-plane base URL. A worker on separate hardware MUST use https:// (plain
# http is rejected for any non-loopback/non-private host).
BUNK_CONTROL_PLANE_URL=https://control.example.com

# Local hypervisor backend: "proxmox" or "esxi".
BUNK_HYPERVISOR=proxmox

BUNK_STATE_DIR=/var/lib/bunk-agent

# --- Proxmox backend (BUNK_HYPERVISOR=proxmox) -------------------------------
BUNK_PROXMOX_HOST=https://HOST:8006
BUNK_PROXMOX_NODE=PVE-NODE-NAME
BUNK_PROXMOX_TOKEN_ID=user@pam!tokenid
BUNK_PROXMOX_TOKEN_SECRET=
# Verify the Proxmox TLS cert (default true). The API token is root-equivalent —
# only set this to false for a self-signed cert on a trusted LAN.
BUNK_PROXMOX_VERIFY_SSL=true

# --- ESXi / vSphere backend (BUNK_HYPERVISOR=esxi) ---------------------------
#BUNK_ESXI_URL=https://VCENTER-OR-ESXI/sdk
#BUNK_ESXI_USER=
#BUNK_ESXI_PASSWORD=
#BUNK_ESXI_INSECURE=false
#BUNK_ESXI_DATACENTER=
#BUNK_ESXI_DATASTORE=
#BUNK_ESXI_RESOURCE_POOL=
#BUNK_ESXI_FOLDER=
#BUNK_ESXI_TEMPLATE=ubuntu-2204-template

# --- VPS networking (how customer VMs are attached + addressed) --------------
#BUNK_VPS_BRIDGE=vmbr0
#BUNK_VPS_VLAN=0
#BUNK_VPS_GATEWAY=
#BUNK_VPS_CIDR_PREFIX=24
#BUNK_VPS_RANGE_START=
#BUNK_VPS_RANGE_END=

# --- Advertised capacity caps (0 = offer everything available) ---------------
#BUNK_OFFER_VCPU=0
#BUNK_OFFER_RAM_MB=0
#BUNK_OFFER_DISK_GB=0

# --- Heartbeat ---------------------------------------------------------------
#BUNK_HEARTBEAT_INTERVAL=30s
